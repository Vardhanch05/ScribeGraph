# .env.example
# Required for QuantInsight

# LLM Provider Key — Groq (fast inference, free tier, OpenAI-SDK compatible)
GROQ_API_KEY=your_groq_key_here

# LlamaParse Key for Stage 1 Extraction
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Optional: Set to true to run agent graph and ingestion using local deterministic mock LLM
MOCK_LLM=false

# Optional: LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
